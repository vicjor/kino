{
  "name": "kino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted media player for the home network: browse, play on any device, cast to Chromecast and DLNA TVs.",
  "license": "MIT",
  "author": "Victor J\u00f8rgensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicjor/kino.git"
  },
  "homepage": "https://github.com/vicjor/kino#readme",
  "keywords": [
    "stremio",
    "torrent",
    "streaming",
    "chromecast",
    "hls",
    "self-hosted",
    "pwa"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "node scripts/dev-guard.ts && concurrently -k \"tsx watch server/index.ts\" \"vite --config vite.config.ts\"",
    "dev:iso": "concurrently -k -n api,vite \"PORT=1299 KINO_DATA=${KINO_DEV_DATA:-$HOME/kino-dev} KINO_HOSTNAME=off KINO_PLAIN_PORT=0 tsx watch server/index.ts\" \"KINO_API_PORT=1299 vite --config vite.config.ts --port 5174\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:desktop": "concurrently -k -n api,vite,app \"PORT=1299 KINO_DATA=${KINO_DEV_DATA:-$HOME/kino-dev} KINO_HOSTNAME=off KINO_PLAIN_PORT=0 tsx watch server/index.ts\" \"KINO_API_PORT=1299 vite --config vite.config.ts --port 5174 --strictPort\" \"PORT=1299 KINO_DEV_URL=http://localhost:5174 electron .\"",
    "build": "bun run build:server && bun run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build:check": "D=$(mktemp -d) && trap 'rm -rf \"$D\"' EXIT && echo \"build:check into $D, dist/ untouched\" && tsc -p tsconfig.server.json --outDir \"$D/server\" && vite build --outDir \"$D/client\" --emptyOutDir && node scripts/verify-build.ts \"$D/client\"",
    "test": "node --test --import tsx --import ./test/setup.ts \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json",
    "knip": "bunx knip@6.39.0",
    "audit:gate": "node scripts/audit-gate.ts",
    "start": "node dist/server/index.js",
    "desktop": "sh scripts/desktop.sh run",
    "desktop:dist": "sh scripts/desktop.sh dist"
  },
  "trustedDependencies": [
    "bufferutil",
    "esbuild",
    "ffmpeg-static",
    "ffprobe-static",
    "node-datachannel",
    "protobufjs",
    "utf-8-validate",
    "utp-native"
  ],
  "dependencies": {
    "bittorrent-tracker": "^11.2.3",
    "bonjour-service": "^1.4.4",
    "castv2-client": "^1.2.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.6",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "hls.js": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "app.kino.desktop",
    "productName": "Kino",
    "copyright": "Copyright 2026 Victor J\u00f8rgensen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json",
      "!dist/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/node-datachannel/**",
      "node_modules/bufferutil/**",
      "node_modules/utf-8-validate/**"
    ],
    "mac": {
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg",
        "!node_modules/ffprobe-static/bin/**"
      ],
      "extraResources": [
        {
          "from": "vendor/ffmpeg/${arch}",
          "to": "ffmpeg",
          "filter": ["ffmpeg", "ffprobe", "COPYING.GPLv3", "README.txt"]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "desktop/Kino.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": null
    },
    "linux": {
      "files": [
        "!node_modules/ffprobe-static/bin/{darwin,win32}{,/**}",
        "!node_modules/ffprobe-static/bin/linux/!(${arch}){,/**}"
      ],
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "client/public/icon-512.png"
    },
    "npmRebuild": false
  }
}
